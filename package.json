{
  "name": "poster-store",
  "version": "0.1.0",
  "private": true,
  "description": "Demo poster storefront: Next.js static export, parametric SVG posters rendered at build time, cart and checkout",
  "repository": { "type": "git", "url": "git+https://github.com/sopilnik/poster-store.git" },
  "homepage": "https://formline.sopilnik.dev",
  "author": "Alexandr Sopilnik",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "render": "tsx scripts/render-posters.ts",
    "dev": "pnpm render && next dev",
    "build": "pnpm render && next build",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint --max-warnings=0 --no-warn-ignored app src functions scripts tests *.mjs *.mts *.ts",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "functions:dev": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "shadcn": "4.22.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.153.0"
  },
  "packageManager": "pnpm@11.28.6"
}
