{
  "name": "poster-store",
  "version": "0.1.0",
  "private": true,
  "author": "Alexandr Sopilnik",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "render": "tsx --tsconfig tsconfig.scripts.json scripts/render-posters.ts",
    "dev": "pnpm render && next dev",
    "build": "pnpm render && next build",
    "preview": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:e2e": "pnpm build",
    "test:e2e": "playwright test",
    "functions:dev": "wrangler dev --port 8787"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hookform/resolvers": "5.9.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@11.26.0"
}
