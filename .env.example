# Copy this file to .env.local before a real build.

# The canonical origin baked into metadataBase and every canonical, OG and sitemap url.
SITE_URL=http://localhost:4321

# The footer author link baked into the static export.
AUTHOR_URL=https://github.com/sopilnik

# The checkout function's origin; unset, the storefront offers only the demo payment.
NEXT_PUBLIC_CHECKOUT_API=
